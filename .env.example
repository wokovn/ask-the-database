# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (Docker PostgreSQL)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=shop
POSTGRES_USER=shop_readonly
POSTGRES_PASSWORD=shop_readonly_secret
DATABASE_URL=postgresql://shop_readonly:shop_readonly_secret@localhost:5432/shop

# Admin Database Connection (Used for running migrations/seeding if needed)
DATABASE_ADMIN_URL=postgresql://postgres:postgres@localhost:5432/shop

# LLM Configuration (Google Gen AI SDK)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Query Constraints
MAX_QUERY_ROWS=100
QUERY_TIMEOUT_MS=5000
